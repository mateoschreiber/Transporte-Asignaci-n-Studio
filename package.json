{
  "name": "transporte-asignacion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/lp-browser.mjs",
    "check:worker": "node ./node_modules/wrangler/bin/wrangler.js deploy --dry-run",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "wrangler": "4.164.0"
  }
}
